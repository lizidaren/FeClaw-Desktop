#!/bin/bash
# pre-commit — 提交前检查 JS 语法
# 安装: git config core.hooksPath .githooks

echo "🔍 [pre-commit] 检查 JS 语法..."
cd "$(git rev-parse --show-toplevel)"

CHANGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$')
if [ -z "$CHANGED_JS" ]; then
    exit 0
fi

ERRORS=0
for f in $CHANGED_JS; do
    if [ -f "$f" ]; then
        OUTPUT=$(node --check "$f" 2>&1)
        if [ $? -ne 0 ]; then
            echo "  ❌ $f"
            echo "     $OUTPUT"
            ERRORS=$((ERRORS + 1))
        else
            echo "  ✅ $f"
        fi
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo ""
    echo "❌ $ERRORS 个 JS 文件有语法错误，提交已阻止"
    echo "   修复后重新 git add + git commit"
    exit 1
fi

echo "✅ JS 语法检查通过"
