{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat",
  "description": "Capabilities for the main Chat window. Covers messaging, agent list, group chat, moments, search, file display, and prompt templates. Sensitive commands (delete_agent / file_delete / vfs_rm) are NOT included here — they live in `dangerous.json` with explicit review hooks.",
