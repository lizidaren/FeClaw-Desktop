{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FeClaw Desktop",
  "version": "0.1.0",
  "identifier": "com.lizidaren.feclaw-desktop",
  "build": {
    "frontendDist": "src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FeClaw Desktop",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
